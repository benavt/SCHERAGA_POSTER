    {
      "key": "origin_md_suffix",
      "name": "MD directory suffix",
      "enabled": true,
      "priority": 11,
      "match": {
        "fields": [
          "model",
          "source_path"
        ],
        "contains_any": [],
        "contains_all": [],
        "contains_none": [
          "non_md",
          "non-md"
        ],
        "regex_any": [
          "(?:^|[/_])[A-Za-z0-9]*MD(?:[/_]|$)"
        ],
