    {
      "key": "scheraga_speachaf_native",
      "name": "SPEACH_AF",
      "enabled": true,
      "priority": -1500,
      "match": {
        "fields": [
          "model",
          "source_path"
        ],
        "contains_any": [
          "SPEACH_AF_native"
        ],
        "contains_all": [],
        "contains_none": [],
        "regex_any": [],
        "case_insensitive": true
      },
      "assign": {
        "model_type": "SPEACH_AF",
        "model_version": "speachaf"
      },
      "color": "#CC6677",
      "notes": "New Mad2 monomer native-method cohort;1,000 source-bound predictions. Boltz2 refold confidence kept separate from native score fields."
    },
