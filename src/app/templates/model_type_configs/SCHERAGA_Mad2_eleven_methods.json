      "enabled": true,
      "priority": 10,
      "match": {
        "fields": [
          "model",
          "source_path"
        ],
        "contains_any": [
          "MD_",
          "_MD/",
          "_MD__",
          "/MD/",
          "ptwte_"
        ],
        "contains_all": [],
        "contains_none": [
          "non_md",
          "non-md"
        ],
        "regex_any": [],
        "case_insensitive": true
      },
      "assign": {
        "model_type": "MD",
        "model_version": null
      },
      "color": "#D55E00",
      "notes": "MD trajectories take precedence over the method used to generate their starting structure."
